---
interface Props {
  figure: "relay" | "sieve" | "plot" | "padlock" | "query" | "turntable" | "dish" | "settle";
  intensity?: number;
  play?: boolean;
  label?: string;
  class?: string;
}

const {
  figure,
  intensity = 0.5,
  play = false,
  label,
  class: className = "",
} = Astro.props;
---

<div
  class={`hairline-figure ${className}`}
  data-hairline-figure={figure}
  data-intensity={intensity}
  data-play={play ? "true" : "false"}
  {...(label ? { "data-label": label } : {})}
>
</div>

<style>
  .hairline-figure {
    width: 100%;
    aspect-ratio: 5 / 4;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
