---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = "/", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} path={path} noindex={noindex} />
    <slot name="head" />
    <script is:inline>
      // Apply saved theme immediately before render to avoid flash
      try {
        const savedTheme = localStorage.getItem("tarnquil_theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", savedTheme);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script src="../scripts/enhance.ts"></script>
  </body>
</html>

<style>
  #main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
