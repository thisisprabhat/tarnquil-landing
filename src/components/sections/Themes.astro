---
import { THEMES } from "../../config/site";
import themeDark from "../../assets/themes/theme-mono-dark.png";
import themeLight from "../../assets/themes/theme-mono-light.png";
import themePaper from "../../assets/themes/theme-paper.png";
import themeSlate from "../../assets/themes/theme-slate.png";
import themeSepia from "../../assets/themes/theme-sepia-night.png";
import themeDusk from "../../assets/themes/theme-dusk.png";
import themeSage from "../../assets/themes/theme-sage.png";

const themeImages = {
  "theme-mono-dark.png": themeDark,
  "theme-mono-light.png": themeLight,
  "theme-paper.png": themePaper,
  "theme-slate.png": themeSlate,
  "theme-sepia-night.png": themeSepia,
  "theme-dusk.png": themeDusk,
  "theme-sage.png": themeSage,
};
---

<section id="themes" class="themes">
  <div class="themes__inner" data-reveal>
    <div class="themes__header">
      <span class="themes__tag">Quiet aesthetics</span>
      <h2>A quieter home screen, your way.</h2>
      <p class="themes__sub">Seven calm themes and four typefaces. Pick one, then forget about it.</p>
    </div>

    <div class="themes__strip-container" role="region" aria-label="Theme previews">
      <ul
        class="themes__strip"
        data-themes
        tabindex="0"
      >
        {
          THEMES.map((t, index) => {
            const img = themeImages[t.file as keyof typeof themeImages];
            return (
              <li class="themes__item" style={`--item-index: ${index};`}>
                <div class="themes__device">
                  <img
                    src={img.src}
                    alt={`Tarnquil home screen in the ${t.name} theme`}
                    width={img.width}
                    height={img.height}
                    loading="lazy"
                    decoding="async"
                    class="themes__img"
                  />
                </div>
                <span class="themes__name">{t.name}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .themes {
    padding: 6rem 1.25rem;
    background-color: var(--surface);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }

  .themes__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .themes__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .themes__tag {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 500;
  }

  .themes__sub {
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .themes__strip-container {
    width: 100%;
    position: relative;
  }

  .themes__strip {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    padding: 1rem 0.5rem 2rem;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: var(--hairline) transparent;
  }

  .themes__strip:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
    border-radius: 1rem;
  }

  .themes__item {
    flex: 0 0 200px;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    transition: transform 200ms ease;
  }

  .themes__device {
    width: 100%;
    aspect-ratio: 9 / 20;
    border-radius: 1rem;
    border: 3px solid var(--hairline);
    overflow: hidden;
    background-color: #000;
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.3);
  }

  .themes__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
  }

  .themes__name {
    font-size: 0.875rem;
    color: var(--muted);
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .themes__strip {
      display: flex;
      justify-content: center;
      gap: 1rem;
      overflow-x: visible;
      padding: 3rem 1rem;
    }

    .themes__item {
      flex: 0 0 150px;
      /* Subtle fanned angle on desktop */
      transform: rotate(calc((var(--item-index) - 3) * 3deg)) translateY(calc(abs(var(--item-index) - 3) * 6px));
    }

    .themes__item:hover {
      transform: translateY(-12px) scale(1.05);
      z-index: 10;
    }
  }
</style>
