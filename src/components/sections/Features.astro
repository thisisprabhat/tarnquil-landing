---
import PhoneFrame from "../PhoneFrame.astro";
import HairlineFigure from "../HairlineFigure.astro";
import { FEATURES } from "../../config/site";
import imgLimits from "../../assets/screens/06-app-limits.png";
import imgReels from "../../assets/screens/11-micro-videos.png";
import imgSchedules from "../../assets/screens/08-schedules.png";

const imageMap = {
  "06-app-limits.png": imgLimits,
  "11-micro-videos.png": imgReels,
  "08-schedules.png": imgSchedules,
};
---

<section id="features" class="features">
  <div class="features__inner" data-reveal>
    <div class="features__header">
      <span class="features__tag">Deliberate simplicity</span>
      <h2>Fewer taps, more days.</h2>
    </div>

    <div class="features__grid">
      {
        FEATURES.map((item) => {
          const hasImage = "image" in item && item.image;
          const imageObj = hasImage ? imageMap[item.image as keyof typeof imageMap] : null;
          const hasFigure = "figure" in item && item.figure;

          return (
            <article class={`feature ${hasImage ? "feature--visual" : "feature--hairline"}`}>
              <div class="feature__body">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>

              {hasImage && imageObj && (
                <div class="feature__frame-wrap">
                  <PhoneFrame
                    src={imageObj}
                    alt={item.alt}
                    loading="lazy"
                    class="feature__phone"
                  />
                </div>
              )}

              {hasFigure && (
                <div class="feature__figure-wrap">
                  <HairlineFigure
                    figure={item.figure as any}
                    label={"label" in item ? (item.label as string) : undefined}
                    intensity={0.6}
                    play={false}
                    class="feature__figure"
                  />
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: 6rem 1.25rem;
  }

  .features__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .features__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .features__tag {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 500;
  }

  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 1.5rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    overflow: hidden;
    transition: border-color 200ms ease;
  }

  .feature:hover {
    border-color: var(--muted);
  }

  .feature__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .feature__body h3 {
    font-size: 1.25rem;
  }

  .feature__body p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .feature__frame-wrap {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    width: 100%;
  }

  .feature__frame-wrap :global(.phone-frame) {
    width: 100%;
    max-width: 190px;
    height: auto;
    aspect-ratio: 9 / 20;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .feature__figure-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 200px;
    margin: 1rem auto 0;
    opacity: 0.85;
    transition: opacity 200ms ease;
  }

  .feature:hover .feature__figure-wrap {
    opacity: 1;
  }
</style>
