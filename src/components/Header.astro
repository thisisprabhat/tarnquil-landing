---
import PlayBadge from "./PlayBadge.astro";
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__brand" aria-label="Tarnquil Home">
      <svg class="header__logo" viewBox="0 0 48 48" width="28" height="28" aria-hidden="true">
        <!-- Tarnquil concentric circle mark -->
        <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3" />
        <circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="2" opacity="0.6" />
        <circle cx="24" cy="24" r="7" fill="currentColor" />
      </svg>
      <span class="header__name">Tarnquil</span>
    </a>

    <nav class="header__nav" aria-label="Main Navigation">
      <a href="/#features">Features</a>
      <a href="/#privacy">Privacy</a>
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark/light theme"
        title="Toggle color theme"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <PlayBadge size="sm" class="header__badge" />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: var(--bg);
    border-bottom: 1px solid var(--hairline);
    backdrop-filter: blur(8px);
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .header__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--text);
  }

  .header__logo {
    color: var(--text);
  }

  .header__name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header__nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .header__nav a:hover {
    color: var(--text);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 9999px;
    border: 1px solid var(--hairline);
    color: var(--muted);
    background: var(--surface);
    transition: color 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    transform: scale(1.05);
  }

  /* Icon visibility based on theme */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }

  :root[data-theme="light"] .icon-sun {
    display: block;
  }
  :root[data-theme="light"] .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .icon-sun {
      display: block;
    }
    :root:not([data-theme="dark"]) .icon-moon {
      display: none;
    }
  }

  :root[data-theme="dark"] .icon-sun {
    display: none !important;
  }
  :root[data-theme="dark"] .icon-moon {
    display: block !important;
  }

  @media (max-width: 600px) {
    .header__inner {
      padding: 0.75rem 1rem;
    }
    .header__nav {
      gap: 1rem;
    }
    .header__badge {
      display: none;
    }
  }
</style>
