---
import HairlineFigure from "../HairlineFigure.astro";
import { FAQ } from "../../config/site";
---

<section id="faq" class="faq">
  <div class="faq__inner" data-reveal>
    <div class="faq__header">
      <div class="faq__query-wrap">
        <HairlineFigure
          figure="query"
          label="Isometric question mark turning toward pointer"
          intensity={0.6}
          play={false}
          class="faq__query"
        />
      </div>
      <span class="faq__tag">Clear Answers</span>
      <h2>Questions</h2>
    </div>

    <div class="faq__list">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.q}</span>
              <svg
                class="faq__icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 6rem 1.25rem;
    background-color: var(--surface);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .faq__inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .faq__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .faq__query-wrap {
    width: 80px;
    margin-bottom: 0.25rem;
    opacity: 0.8;
  }

  .faq__tag {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 500;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq__item {
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background-color: var(--bg);
    overflow: hidden;
    transition: border-color 150ms ease;
  }

  .faq__item:hover {
    border-color: var(--muted);
  }

  .faq__question {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex-shrink: 0;
    transition: transform 200ms ease;
    color: var(--muted);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 1.5rem 1.25rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
