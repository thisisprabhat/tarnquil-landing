---
import HairlineFigure from "../HairlineFigure.astro";
---

<section id="privacy" class="privacy">
  <div class="privacy__inner" data-reveal>
    <div class="privacy__header">
      <div class="privacy__header-text">
        <span class="privacy__tag">On-Device Privacy</span>
        <h2>Nothing leaves your phone.</h2>
        <p class="privacy__lead">
          A launcher that helps you step away from screens shouldn't track how you use them. Tarnquil is built from the ground up to keep your life private.
        </p>
      </div>
      <div class="privacy__padlock-wrap">
        <HairlineFigure
          figure="padlock"
          label="Isometric hardware padlock locked on-device"
          intensity={0.5}
          play={false}
          class="privacy__padlock"
        />
      </div>
    </div>

    <dl class="privacy__grid">
      <div class="privacy__item">
        <dt>No accounts</dt>
        <dd>No signup, no login, no profile, no syncing. Just install and open.</dd>
      </div>

      <div class="privacy__item">
        <dt>No ads or analytics</dt>
        <dd>Zero tracking SDKs, zero ad networks, and zero telemetry pings.</dd>
      </div>

      <div class="privacy__item">
        <dt>On-device only</dt>
        <dd>Your usage statistics, notifications, limits, and notes never leave your device.</dd>
      </div>

      <div class="privacy__item">
        <dt>100% Free</dt>
        <dd>Free to use forever, with no hidden paywalls, subscriptions, or dark patterns.</dd>
      </div>
    </dl>

    <div class="privacy__permission">
      <h3>Why the Accessibility permission?</h3>
      <p>
        Tarnquil uses the Android Accessibility permission only to detect which app or short-video screen is currently open so your limits and Reels/Shorts blocking can work. It never reads what you type, and nothing is stored or sent off the device.
      </p>
      <div class="privacy__policy-link">
        <a href="/privacy">Read the full Privacy Policy →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy {
    padding: 6rem 1.25rem;
  }

  .privacy__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .privacy__header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .privacy__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .privacy__header-text {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .privacy__padlock-wrap {
    width: 140px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .privacy__tag {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 500;
  }

  .privacy__lead {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .privacy__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .privacy__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .privacy__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .privacy__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 1rem;
  }

  .privacy__item dt {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text);
  }

  .privacy__item dd {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .privacy__permission {
    max-width: 680px;
    padding: 2rem;
    background-color: var(--surface);
    border-left: 3px solid var(--text);
    border-radius: 0 1rem 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .privacy__permission h3 {
    font-size: 1.25rem;
  }

  .privacy__permission p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .privacy__policy-link {
    margin-top: 0.5rem;
  }

  .privacy__policy-link a {
    font-weight: 500;
    color: var(--text);
  }
</style>
