---
interface Props {
  app?: string;
  class?: string;
}

const { app = "Instagram", class: className = "" } = Astro.props;
---

<div class={`pause-demo ${className}`} data-pause-demo>
  <div class="pause-demo__card">
    <div class="pause-demo__header">
      <span class="pause-demo__app-tag">{app}</span>
      <button type="button" class="pause-demo__replay" data-pause-replay aria-label="Replay pause animation">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
      </button>
    </div>

    <div class="pause-demo__body">
      <div class="pause-demo__breath-wrap">
        <p class="pause-demo__breath-text" data-pause-text>Take a breath…</p>
        <div class="pause-demo__progress-track">
          <div class="pause-demo__progress-bar" data-pause-bar></div>
        </div>
      </div>

      <div class="pause-demo__prompt">
        <p class="pause-demo__question">How long do you want to spend here?</p>
      </div>

      <div class="pause-demo__options" data-pause-options>
        <button type="button" class="pause-demo__opt">1 min</button>
        <button type="button" class="pause-demo__opt">5 min</button>
        <button type="button" class="pause-demo__opt">10 min</button>
        <button type="button" class="pause-demo__opt">15 min</button>
        <button type="button" class="pause-demo__opt">30 min</button>
      </div>
    </div>
  </div>
</div>

<style>
  .pause-demo {
    width: 100%;
    max-width: 360px;
    margin: 1.5rem 0;
  }

  .pause-demo__card {
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pause-demo__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pause-demo__app-tag {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 500;
  }

  .pause-demo__replay {
    color: var(--muted);
    padding: 0.25rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: color 150ms ease, transform 150ms ease;
  }

  .pause-demo__replay:hover {
    color: var(--text);
    transform: rotate(-45deg);
  }

  .pause-demo__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pause-demo__breath-text {
    font-size: 0.9375rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .pause-demo__progress-track {
    width: 100%;
    height: 3px;
    background-color: var(--hairline);
    border-radius: 2px;
    overflow: hidden;
  }

  .pause-demo__progress-bar {
    width: 100%;
    height: 100%;
    background-color: var(--text);
    transform-origin: left center;
    transform: scaleX(1);
  }

  .pause-demo__question {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--text);
  }

  .pause-demo__options {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.375rem;
  }

  .pause-demo__opt {
    padding: 0.5rem 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-align: center;
    background-color: var(--bg);
    border: 1px solid var(--hairline);
    border-radius: 0.5rem;
    color: var(--text);
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .pause-demo__opt:hover {
    border-color: var(--text);
  }

  /* Progressive enhancement: hide options initially only under html.js when animations are supported */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .pause-demo__options .pause-demo__opt {
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 240ms ease, transform 240ms ease;
    }

    :global(html.js) .pause-demo__options .pause-demo__opt.is-in {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pause-demo__progress-bar {
      transform: scaleX(0) !important;
    }
    :global(html.js) .pause-demo__options .pause-demo__opt {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
